%% cv.sty - all styling for the CV.
%%
%% THIS FILE IS YOURS TO EDIT. It is never regenerated, so your styling
%% survives every rebuild of cv.tex. Content lives in me.md; cv.tex is
%% generated from it and holds no styling at all.
%%
%% Everything you are likely to want to change is in STYLE KNOBS below.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}[2026/09/21 v1 CV style]

% Language, for hyphenation and typographic conventions. Passed as the package
% option in cv.tex: \usepackage[slovak]{cv}, \usepackage[czech]{cv}, etc.
% Defaults to english. Non-English languages need their babel patterns
% installed (Fedora: texlive-lang-czechslovak, texlive-lang-european).
% Options accumulate, so a language can be combined with babel switches, e.g.
% \usepackage[czech,shorthands=off]{cv} - Czech babel makes " active, which
% bites if a CV ever contains a literal quote character.
\newcommand{\cv@lang}{}
\DeclareOption*{%
  \ifx\cv@lang\@empty
    \edef\cv@lang{\CurrentOption}%
  \else
    \edef\cv@lang{\cv@lang,\CurrentOption}%
  \fi}
\ProcessOptions\relax
\ifx\cv@lang\@empty\def\cv@lang{english}\fi

% Engine-aware fonts: the same file works under xelatex and pdflatex.
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \RequirePackage{tgheros}
  \renewcommand{\familydefault}{\sfdefault}
\else
  \RequirePackage{fontspec}
  % Loaded by filename via kpathsea, not by fontconfig name: the name form
  % silently falls back to nullfont wherever TeX Live's fonts are not
  % registered with fontconfig, which produces a blank PDF.
  \setmainfont{texgyreheros}[
    Extension      = .otf,
    UprightFont    = *-regular,
    BoldFont       = *-bold,
    ItalicFont     = *-italic,
    BoldItalicFont = *-bolditalic,
    Ligatures      = TeX,
  ]
\fi

\RequirePackage[\cv@lang]{babel}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{microtype}
\RequirePackage{hyperref}

% =====================  STYLE KNOBS  =====================
\definecolor{cvaccent}{HTML}{1F4E79}   % headings, links
\definecolor{cvmuted}{HTML}{5C6670}    % dates, locations, contact line
\definecolor{cvrule}{HTML}{9FB2C6}     % hairline under section headings
\newcommand{\cvlabelwidth}{4.3cm}      % width of the Skills label column
\newcommand{\cvnamesize}{22}           % name size in pt
\newcommand{\cvrolesize}{11.5}         % role line under the name, in pt
\newcommand{\cvphotofile}{photo.jpg}   % in assets/; the photo is optional
\newcommand{\cvphotosize}{2.8cm}       % width of the photo
\newcommand{\cvcontactgap}{0.9em}      % gap between contact label and value
\RequirePackage[a4paper,margin=1.8cm,top=1.2cm,bottom=1.3cm,footskip=0.7cm]{geometry}
% =========================================================

% Is an argument empty? Used by \cvheader for the optional role line and by
% \cvjob to drop a row it has nothing to put in. \detokenize is e-TeX, so this
% works under both xelatex and pdflatex.
\newcommand{\cv@ifblank}[3]{\if\relax\detokenize{#1}\relax#2\else#3\fi}

\hypersetup{colorlinks=true, urlcolor=cvaccent, linkcolor=cvaccent, pdfborder={0 0 0}}

% Page 1 is bare; every later page carries name and page number, because a
% two-page CV gets printed, separated, and page 2 has to identify itself.
%
% "2 of 2", not "2": the reader's question is whether they are holding all of
% it, and a bare folio does not answer that. The total comes from a label set
% at the end of the document rather than the lastpage package, which is not in
% every TeX installation; compile.sh already runs two passes, which is what a
% forward reference needs. The label goes before the final \clearpage, not
% after it: \label writes through a whatsit carried on the current page, and a
% page that has already been flushed never ships it, so the reference silently
% stays "??".
\gdef\cv@name{}
\AtEndDocument{\label{cv@lastpage}}
\def\ps@cvpages{%
  \def\@oddhead{}\def\@evenhead{}%
  \def\@oddfoot{%
    \ifnum\value{page}>1
      \hb@xt@\textwidth{\footnotesize\color{cvmuted}\cv@name\hfil
        \thepage\ of \pageref{cv@lastpage}}%
    \fi}%
  \let\@evenfoot\@oddfoot
}
\pagestyle{cvpages}
\setlength{\parindent}{0pt}
\setlength{\parskip}{2.5pt}
\linespread{1.0}\selectfont   % a little air; CV text is read in a hurry
\raggedright
\raggedbottom

% Keep a heading with its rule and the first lines of its content, so a
% heading never strands at the foot of a page.
%
% This measures the space actually left on the page (\pagegoal - \pagetotal)
% and breaks only if there genuinely is not enough. The usual needspace
% trick - insert stretchable glue, then a penalty - is WRONG here: this
% document is \raggedbottom, so the page already carries infinitely
% stretchable glue, the finite glue cannot compete, and the penalty fires as
% an attractive break with two thirds of the page still empty.
% The \ifdim\dimen@>\z@ guard covers \pagegoal being \maxdimen on a fresh page.
\newcommand{\cvneedspace}[1]{%
  \par
  \begingroup
    \dimen@\pagegoal \advance\dimen@-\pagetotal
    \ifdim #1>\dimen@ \ifdim\dimen@>\z@ \newpage \fi\fi
  \endgroup
}

% ---- \cvheader[role]{name}{contact block} ----
% With a photo in assets/ the header goes two-column, text left and photo
% right. With no photo the text is centred instead. Nothing to switch on:
% drop the file in or delete it.
%
% The optional role line sits under the name in the accent colour, so the top
% of the page and the section bands read as one system. It is off unless asked
% for: a bare name is a legitimate choice, and this is the profile owner's call.
\newcommand{\cvheadertext}[3]{%
  {\fontsize{\cvnamesize}{\cvnamesize}\selectfont\bfseries #1}%
  \cv@ifblank{#2}{\\[9pt]}%
    {\\[3pt]{\fontsize{\cvrolesize}{\cvrolesize}\selectfont\bfseries\color{cvaccent}#2}\\[8pt]}%
  #3%
}
\newcommand{\cvheader}[3][]{%
  \gdef\cv@name{#2}%
  \IfFileExists{\cvphotofile}{%
    \noindent
    \begin{minipage}[c]{\dimexpr\linewidth-\cvphotosize-1.2em\relax}
      \raggedright\cvheadertext{#2}{#1}{#3}
    \end{minipage}%
    \hfill
    \begin{minipage}[c]{\cvphotosize}
      \includegraphics[width=\cvphotosize,height=\cvphotosize,keepaspectratio]{\cvphotofile}
    \end{minipage}%
    \par\vspace{4pt}%
  }{%
    \begin{center}\cvheadertext{#2}{#1}{#3}\end{center}
    \vspace{2pt}%
  }%
}
% ---- contact block: one item per line, labels aligned ----
%   \begin{cvcontacts}
%     \cvcontact{Email}{me@example.com}
%     \cvcontact{GitHub}{\href{https://...}{github.com/...}}
%   \end{cvcontacts}
% Plain tabular, which - unlike tabularx - wraps in a \newenvironment fine.
\newenvironment{cvcontacts}
  {\footnotesize\renewcommand{\arraystretch}{1.1}%
   \begin{tabular}{@{}l@{\hspace{\cvcontactgap}}l@{}}}
  {\end{tabular}}
\newcommand{\cvcontact}[2]{{\color{cvmuted}#1} & #2\\}

% ---- sections ----
\titleformat{\section}
  {\normalsize\bfseries\color{cvaccent}}{}{0pt}
  {\cvneedspace{6\baselineskip}\MakeUppercase}
  [\nobreak\vspace{-7pt}\color{cvrule}\rule{\linewidth}{0.9pt}\nobreak]
\titlespacing*{\section}{0pt}{8pt}{4pt}

% ---- \cvjob{role}{organisation}{dates}{location} - dates right-aligned ----
% Pass {} for a field you do not have.
%
% tabular* with \extracolsep{\fill}, not tabularx: an X column is a paragraph
% box whose first baseline \linespread shifts, which left the dates sitting
% above the line they belong to. Plain l/r cells share a baseline exactly.
% \hfill would not work here either - \raggedright makes \rightskip stretch,
% so the right-hand text would land mid-line instead of flush right.
%
% An entry with neither organisation nor location - a project under Selected
% Work, say - gets a one-row table. Typesetting the second row empty costs a
% full blank line between the title and its bullets. The two shapes are two
% separate tabulars rather than an \if inside one: a & or \\ arriving from
% macro expansion mid-alignment is exactly the kind of thing that works until
% it does not.
\newcommand{\cv@jobrow}[2]{%
  \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}l r@{}}
    \textbf{#1} & {\small\color{cvmuted}#2}
  \end{tabular*}%
}
\newcommand{\cv@jobrows}[4]{%
  \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}l r@{}}
    \textbf{#1} & {\small\color{cvmuted}#3}\\
    {\itshape\color{cvaccent}#2} & {\small\itshape\color{cvmuted}#4}
  \end{tabular*}%
}
\newcommand{\cvjob}[4]{%
  \vspace{3pt}%
  \begingroup\renewcommand{\arraystretch}{0.94}%
  \cv@ifblank{#2}{\cv@ifblank{#4}{\cv@jobrow{#1}{#3}}{\cv@jobrows{#1}{#2}{#3}{#4}}}%
                 {\cv@jobrows{#1}{#2}{#3}{#4}}%
  \endgroup
  \vspace{2pt}%
}

% ---- bullets ----
\setlist[itemize]{
  leftmargin=1.1em, itemsep=3pt, topsep=4pt, parsep=0pt, partopsep=0pt,
  label=\textcolor{cvaccent}{\scriptsize\raisebox{0.15ex}{\textbullet}}
}

% ---- \begin{cvskills} ... \end{cvskills}: aligned label/value block ----
%   \begin{cvskills}
%     Programming & Java, Kotlin \\
%   \end{cvskills}
%
% A tabular with two p-columns, not an enumitem description list: with
% description's multiline style, a label that wraps to two lines overflows
% downward without growing the row, so the next label prints on top of it.
% p-columns grow the row instead. Plain tabular - unlike tabularx - wraps in
% a \newenvironment without complaint.
\newenvironment{cvskills}
  {\renewcommand{\arraystretch}{1.3}%
   \begin{tabular}{@{}>{\raggedright\arraybackslash\bfseries}p{\cvlabelwidth}@{\hspace{0.7em}}%
                     >{\raggedright\arraybackslash}p{\dimexpr\textwidth-\cvlabelwidth-0.7em\relax}@{}}}
  {\end{tabular}}

\endinput
